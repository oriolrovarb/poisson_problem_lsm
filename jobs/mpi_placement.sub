# Submit from the repo folder:  bsub < jobs/mpi_placement.sub
# Rank placement on one node (2 sockets x 12 cores): same runs as mpi_decomp.sub, but
#   core   : ranks fill socket 0 first, then socket 1   (default of mpi_decomp.sub)
#   socket : ranks alternate between the two sockets    (uses both memory controllers early)
# Only the mapping changes. --report-bindings prints where each rank went (in the .err file).

module load matplotlib/3.10.3-numpy-2.3.1-python-3.12.11 >& /dev/null
module load mpi4py/4.0.3-python-3.12.11-openmpi-5.0.8 >& /dev/null

lscpu | grep -E "Model name|Socket|NUMA node"

N=200
ITER=100
REPS=3

LAYOUTS="
slab:4x1x1 slab:8x1x1 slab:12x1x1 slab:16x1x1
pencil:2x2x1 pencil:4x2x1 pencil:4x3x1 pencil:4x4x1
cube:2x2x2 cube:3x2x2 cube:4x2x2
"

for MAP in core socket; do
    for L in $LAYOUTS; do
        GRID=${L#*:}
        DIMS=$(echo $GRID | tr x ' ')
        NP=$(echo $DIMS | awk '{print $1*$2*$3}')
        for REP in $(seq $REPS); do
            mpirun -n $NP --map-by $MAP --bind-to core --report-bindings \
                python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 \
                --dims $DIMS --csv results/mpi_placement_${MAP}.csv
        done
    done
done
