# Submit from the repo folder:  bsub < jobs/hybrid.sub
# Hybrid MPI + Numba on one node (24 cores): ranks x threads, slab decomposition.

module load matplotlib/3.10.3-numpy-2.3.1-python-3.12.11 >& /dev/null
module load mpi4py/4.0.3-python-3.12.11-openmpi-5.0.8 >& /dev/null

lscpu | grep -E "Model name|Socket|cache"

N=200
ITER=100

# "ranks x threads": first 1 rank with more threads, then mixes that use all 24 cores
RUNS="1x1 1x2 1x4 1x8 1x12 1x16 1x24 24x1 12x2 8x3 6x4 4x6 2x12"

for RUN in $RUNS; do
    R=${RUN%x*}
    T=${RUN#*x}
    # each rank gets T cores, so Numba can start T threads
    mpirun -n $R --map-by slot:PE=$T --bind-to core \
        python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 \
        --dims $R 1 1 --numba --threads $T --csv results/hybrid.csv
done
