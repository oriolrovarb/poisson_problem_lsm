# Test which N gives each node enough work. The node count comes from -n, so submit
# one job per node count from the repo folder:
#   bsub -n 24  < jobs/size_test.sub     # 1 node (also runs the Numba and memory checks)
#   bsub -n 48  < jobs/size_test.sub     # 2 nodes
#   bsub -n 96  < jobs/size_test.sub     # 4 nodes
#   bsub -n 144 < jobs/size_test.sub     # 6 nodes (all of hpcintro)
# Every run writes the per-rank compute/comm split to results/size_test_ranks.csv.

module load matplotlib/3.10.3-numpy-2.3.1-python-3.12.11 >& /dev/null
module load mpi4py/4.0.3-python-3.12.11-openmpi-5.0.8 >& /dev/null

NP=$LSB_DJOB_NUMPROC
echo "ranks: $NP"
echo "hosts: $LSB_HOSTS" | tr ' ' '\n' | sort | uniq -c

ITER=100
OUT="--csv results/size_test.csv --rank-csv results/size_test_ranks.csv"

for N in 200 400 600; do
    # cube = balanced 3D grid chosen by MPI.Compute_dims, slab = NP x 1 x 1
    for DIMS in "" "--dims $NP 1 1"; do
        mpirun -n $NP --map-by ppr:24:node --bind-to core \
            python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 $DIMS $OUT
    done
done

if [ $NP -eq 24 ]; then
    # Numba on one node: is N=400 long enough to time?
    for N in 200 400; do
        mpirun -n 1 --bind-to core \
            python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --numba --threads 1 $OUT
        mpirun -n 24 --map-by ppr:24:node --bind-to core \
            python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --numba --threads 1 $OUT
        mpirun -n 6 --map-by slot:PE=4 --bind-to core \
            python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --dims 6 1 1 --numba --threads 4 $OUT
    done
    # memory of the largest sequential reference (N=400, 1 rank, NumPy) against -M 4GB
    /usr/bin/time -v python3 main_sequential.py -N 400 --max-iter 10 --tol 0 2>&1 \
        | grep -E "Maximum resident|Elapsed"
fi
