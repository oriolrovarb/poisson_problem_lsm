# LSBATCH: User input
#BSUB -J poisson_size_numba
#BSUB -q hpcintro
#BSUB -W 0:20
#BSUB -M 4GB
#BSUB -R "span[ptile=24]"
#BSUB -o jobs/output/poisson_size_numba_%J.out
#BSUB -e jobs/output/poisson_size_numba_%J.err

# Numba part of the size test. The node count comes from -n, submit from the repo folder:
#   bsub -n 24 < jobs/size_test_numba.sub     # 1 node: is N=400 long enough to time?
#   bsub -n 48 < jobs/size_test_numba.sub     # 2 nodes: which N keeps each node busy?
#   bsub -n 72 < jobs/size_test_numba.sub     # 3 nodes
# Needs numba for the Python 3.12 module:  pip install --user numba  (with the modules below loaded)

module load matplotlib/3.10.3-numpy-2.3.1-python-3.12.11 >& /dev/null
module load mpi4py/4.0.3-python-3.12.11-openmpi-5.0.8 >& /dev/null

NP=$LSB_DJOB_NUMPROC
echo "cores: $NP"
echo "hosts: $LSB_HOSTS" | tr ' ' '\n' | sort | uniq -c

ITER=100
OUT="--csv results/size_test.csv --rank-csv results/size_test_ranks.csv"

if [ $NP -eq 24 ]; then
    SIZES="200 400"
else
    SIZES="400 600 700"
fi

for N in $SIZES; do
    if [ $NP -eq 24 ]; then
        mpirun -n 1 --bind-to core \
            python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --numba --threads 1 $OUT
    fi
    # 24 ranks x 1 thread per node (cube), and 6 ranks x 4 threads per node (cube)
    mpirun -n $NP --map-by ppr:24:node --bind-to core \
        python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --numba --threads 1 $OUT
    mpirun -n $((NP / 4)) --map-by ppr:6:node:PE=4 --bind-to core \
        python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --numba --threads 4 $OUT
done

