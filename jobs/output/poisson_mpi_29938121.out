# LSBATCH: User input
#BSUB -J poisson_mpi
#BSUB -q hpcintro
#BSUB -W 1:00
#BSUB -M 4GB
#BSUB -n 24
#BSUB -R "span[hosts=1]"
#BSUB -o jobs/poisson_mpi_%J.out
