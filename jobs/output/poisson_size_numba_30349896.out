# LSBATCH: User input
#BSUB -J poisson_size_numba
#BSUB -q hpcintro
#BSUB -W 0:20
#BSUB -M 4GB
#BSUB -n 24
#BSUB -R "span[hosts=1]"
#BSUB -o jobs/output/poisson_size_numba_%J.out
#BSUB -e jobs/output/poisson_size_numba_%J.err

# Numba part of the size test: is N=400 long enough to time on one node?
# Submit from the repo folder:  bsub < jobs/size_test_numba.sub
# Needs numba for the Python 3.12 module:  pip install --user numba  (with the modules below loaded)

module load matplotlib/3.10.3-numpy-2.3.1-python-3.12.11 >& /dev/null
module load mpi4py/4.0.3-python-3.12.11-openmpi-5.0.8 >& /dev/null

ITER=100
OUT="--csv results/size_test.csv --rank-csv results/size_test_ranks.csv"

for N in 200 400; do
    mpirun -n 1 --bind-to core \
        python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --numba --threads 1 $OUT
    mpirun -n 24 --map-by ppr:24:node --bind-to core \
        python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --numba --threads 1 $OUT
    mpirun -n 6 --map-by slot:PE=4 --bind-to core \
        python3 main_mpi_cart.py -N $N --max-iter $ITER --tol 0 --dims 6 1 1 --numba --threads 4 $OUT
done

